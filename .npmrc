# Every dependency is pinned to an exact version in package.json, and
# pnpm-lock.yaml is committed. These settings keep it that way.

# `pnpm add x` records "1.2.3", never "^1.2.3".
save-exact=true

# Install fails rather than silently updating the lockfile. This is the setting
# that stops an install on another machine from resolving newer versions.
# Adding or upgrading a dependency on purpose needs an explicit opt-out:
#   pnpm install --no-frozen-lockfile
#   pnpm add <pkg>@<version> --no-frozen-lockfile
frozen-lockfile=true

# Refuse to install under a Node or pnpm outside the "engines" range.
engine-strict=true

# Transitive dependencies resolve to one version per range, not the newest
# published at install time.
resolution-mode=highest
