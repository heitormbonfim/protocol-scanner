# npm's settings. pnpm no longer reads a project-level .npmrc, so its
# equivalents live in pnpm-workspace.yaml — keep the two in step.
#
# Only keys npm actually understands belong here: it warns on anything else,
# and a future major will reject it.

# `npm install x` records "1.2.3", never "^1.2.3". A pin, not a gate — it
# affects what gets written when you add a package, and never blocks an
# install.
save-exact=true

# Deliberately NOT set here:
#
#   engine-strict   would turn the advisory "engines" range into a hard install
#                   failure. Left off so an older Node warns instead of
#                   refusing.
#
# npm has no frozen-lockfile config key. The reproducible install is `npm ci`,
# which installs package-lock.json exactly and fails if it has drifted from
# package.json. Use it in CI; plain `npm install` stays forgiving.
